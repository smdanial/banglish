# Copy this file to ".env" (same folder) for local use, or enter the same names in Vercel / Cloudflare.
# Never commit .env. Find both values in Supabase -> Project Settings -> API (or "API Keys").

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# PUBLIC key that goes into the web page: the "anon public" key (starts with eyJ...)
# or the new "publishable" key (starts with sb_publishable_...). It can only insert (see supabase/setup.sql).
SUPABASE_ANON_KEY=

# Optional web page settings
SUPABASE_BUCKET=recordings
SESSION_GOAL=50
# Shown on the consent screen so volunteers know who to contact (e.g. an email address). Optional.
CONTACT_TEXT=

# ADMIN key - ONLY for scripts/export_dataset.py and scripts/check_setup.py on your own computer.
# "service_role" key (eyJ...) or new "secret" key (sb_secret_...). NEVER put this in Vercel/Cloudflare.
SUPABASE_SERVICE_ROLE_KEY=
